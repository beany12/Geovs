# Copy this to .env and fill in your values

# Server
PORT=3000
NODE_ENV=production

# Security — comma-separated list of valid API keys
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEYS=your-key-1-here,your-key-2-here

# HMAC secret for signing questions (min 32 chars)
SESSION_SECRET=change-this-to-a-long-random-string-min-32-chars

# CORS — your frontend URL (no trailing slash)
ALLOWED_ORIGIN=https://your-site.netlify.app

# Admin UIDs — comma-separated Firebase UIDs that can access /api/admin/*
ADMIN_UIDS=your-firebase-uid-here

# Firebase Admin SDK (Service Account als JSON-String)
# So bekommst du ihn: Firebase Console → Projekteinstellungen → Service Accounts → "Neuen privaten Schlüssel generieren"
# Den Inhalt der JSON-Datei als eine Zeile einfügen (Zeilenumbrüche durch \n ersetzen):
# node -e "console.log(JSON.stringify(require('./serviceAccount.json')))"
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"DEIN-PROJEKT",...}
